# Settings for the large language model (LLM) the agent uses. Copy this file
# to .env and fill in the three values; README.md lists the addresses of
# common providers. .env is listed in .gitignore and stays on this computer.
#
# LLM_BASE_URL  the provider's address for the chat completions interface.
#               Leave empty for OpenAI.
# LLM_MODEL     the model name as the provider lists it. The model must
#               support tool calling (also called function calling).
# LLM_API_KEY   the key from the provider's console.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
